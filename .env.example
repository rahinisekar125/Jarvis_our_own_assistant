JARVIS_LLM_MAX_RETRIES=3
JARVIS_LLM_RETRY_BASE_DELAY_SECONDS=2
JARVIS_LLM_RETRY_MAX_DELAY_SECONDS=30
JARVIS_LLM_COOLDOWN_SECONDS=1
JARVIS_VOICE_LLM_PROVIDER=gemini
JARVIS_VOICE_LLM_TIMEOUT_SECONDS=5
JARVIS_VOICE_LLM_MAX_RETRIES=1
JARVIS_VOICE_LLM_RETRY_BASE_DELAY_SECONDS=0.5
JARVIS_VOICE_LLM_COOLDOWN_SECONDS=0
JARVIS_VOICE_OLLAMA_BACKUP=true
JARVIS_CONFIG=config.yaml
JARVIS_DATA_DIR=data
JARVIS_ALLOWED_PATHS=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
JARVIS_OLLAMA_TIMEOUT_SECONDS=60
JARVIS_OLLAMA_MAX_RETRIES=1
JARVIS_OLLAMA_BACKUP=true

GEMINI_API_KEY=
MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash


JARVIS_WAKE_ENGINE=vosk
JARVIS_WAKE_ALIASES=hey jarvis
JARVIS_VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
JARVIS_SAMPLE_RATE=16000
JARVIS_INPUT_DEVICE=5
JARVIS_INPUT_CHANNELS=1
PICOVOICE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=
JARVIS_WAKE_WORD=hey jarvis
JARVIS_WAKE_GREETING=hi Ayush tell me something what you want
JARVIS_SPEAK_WAKE_GREETING=false
JARVIS_WHISPER_WAKE_SECONDS=1.6
JARVIS_WHISPER_WAKE_COOLDOWN_SECONDS=0.05
JARVIS_WAKE_ENERGY_THRESHOLD=180
JARVIS_WAKE_WHISPER_MODEL=tiny.en

JARVIS_STT_ENGINE=whisper
JARVIS_STT_MIN_CONFIDENCE=0.60
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_INITIAL_PROMPT=Indian English and Hinglish voice command for Jarvis. Common words: Ayush, Jarvis, kholo, batao, chalao, bajao, likho, dhoondo, notepad, chrome, battery, time, date.
WHISPER_HOTWORDS=Ayush Jarvis hey Jarvis Indian English Hinglish kholo kholna batao chalao bajao likho dhoondo dhundo notepad chrome YouTube battery time date system status open type search play
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
JARVIS_SILENCE_SECONDS=0.32
JARVIS_MAX_RECORD_SECONDS=5
JARVIS_SPEECH_START_TIMEOUT_SECONDS=1.2
JARVIS_ENERGY_THRESHOLD=75

JARVIS_TTS_BACKEND=edge
JARVIS_TTS_VOICE=en-IN-PrabhatNeural
JARVIS_TTS_RATE=250
JARVIS_TTS_VOLUME=1.0
JARVIS_TTS_EDGE_RATE=+8%
JARVIS_TTS_EDGE_VOLUME=+0%
JARVIS_VISUAL_OUTPUT=true
JARVIS_VISUAL_ALWAYS_ON_TOP=true
JARVIS_VISUAL_WIDTH=520
JARVIS_VISUAL_HEIGHT=320
JARVIS_VISUAL_DURATION_SECONDS=18
JARVIS_VISUAL_SHOW_STARTUP=false
JARVIS_VISUAL_SHOW_WAKE=true
JARVIS_VISUAL_SHOW_HEARD=false
JARVIS_VISUAL_SHOW_FINAL=true

